locale.keymap_options           file    /etc/dconf/db/local.d/00_keyboard
locale.locales                  file    /etc/locale.gen
locale.locales                  file    /usr/lib/locale/locale-archive
# /etc/default/locale where it is a file, /etc/locale.conf where it is a link
# to that. LANG defaults to the first of locale.locales.
locale.lang                     file    /etc/default/locale
locale.lang                     file    /etc/locale.conf
locale.lc_time                  file    /etc/default/locale
locale.lc_time                  file    /etc/locale.conf
locale.lc_measurement           file    /etc/default/locale
locale.lc_measurement           file    /etc/locale.conf

