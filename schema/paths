locale.keymap                   file    /etc/dconf/db/local.d/00_keyboard
locale.keymap_model             file    /etc/default/keyboard
locale.keymap_model             file    /etc/xdg/labwc-greeter/environment
locale.keymap_model             file    /usr/share/labwc/environment
locale.keymap_model             home    .config/labwc/environment
locale.keymap_model             dir     /etc/console-setup
locale.keymap_model             file    /etc/dconf/profile/user
locale.keymap_model             file    /etc/dconf/db/local.d/00_keyboard
locale.keymap_variant           file    /etc/default/keyboard
locale.keymap_variant           file    /etc/xdg/labwc-greeter/environment
locale.keymap_variant           file    /usr/share/labwc/environment
locale.keymap_variant           home    .config/labwc/environment
locale.keymap_variant           dir     /etc/console-setup
locale.keymap_variant           file    /etc/dconf/profile/user
locale.keymap_variant           file    /etc/dconf/db/local.d/00_keyboard
locale.keymap_options           file    /etc/default/keyboard
locale.keymap_options           file    /etc/xdg/labwc-greeter/environment
locale.keymap_options           file    /usr/share/labwc/environment
locale.keymap_options           home    .config/labwc/environment
locale.keymap_options           dir     /etc/console-setup
