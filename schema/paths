ethernet.address                file    /etc/NetworkManager/system-connections/preconfigured-ethernet.nmconnection
ethernet.gateway                file    /etc/NetworkManager/system-connections/preconfigured-ethernet.nmconnection
ethernet.dns                    file    /etc/NetworkManager/system-connections/preconfigured-ethernet.nmconnection
ethernet.dns_search             file    /etc/NetworkManager/system-connections/preconfigured-ethernet.nmconnection
ethernet.interface              file    /etc/NetworkManager/system-connections/preconfigured-ethernet.nmconnection

locale.timezone                 file    /etc/timezone
locale.timezone                 file    /etc/localtime
# /etc/console-setup and dconf are via raspi-config (do_configure_keyboard).
locale.keymap                   file    /etc/default/keyboard
locale.keymap                   file    /etc/xdg/labwc-greeter/environment
locale.keymap                   file    /usr/share/labwc/environment
locale.keymap                   home    .config/labwc/environment
locale.keymap                   dir     /etc/console-setup
